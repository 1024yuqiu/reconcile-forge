{
  "name": "reconcile-for-atlassian",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build --config vite.config.js",
    "preview": "vite --config vite.config.js --mode mock --host 127.0.0.1",
    "test": "node --test tests/*.test.js",
    "test:ui": "node scripts/ui-check.js",
    "test:reference": "node scripts/reference-check.js",
    "check:manifest": "node scripts/manifest-check.js",
    "samples": "node scripts/samples.js",
    "licenses": "node scripts/licenses.js",
    "lint:forge": "forge lint",
    "test:adapter": "node --experimental-test-module-mocks --test tests/*.test.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1165.0",
    "@forge/api": "8.5.0",
    "@forge/bridge": "7.3.0",
    "@forge/kvs": "2.1.2",
    "@forge/resolver": "2.0.2",
    "exceljs": "4.4.0",
    "papaparse": "5.7.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@forge/cli": "15.1.0",
    "@vitejs/plugin-react": "5.2.0",
    "playwright": "1.65.0",
    "vite": "7.3.8"
  },
  "overrides": {
    "exceljs": {
      "unzipper": "0.12.5"
    }
  }
}
